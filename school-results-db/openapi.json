      "post": {
        "summary": "Create a versioned grading scale (Admin only)",
        "tags": [
          "Configuration"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/config/grading-scales/{scaleId}/bands": {
      "post": {
        "summary": "Add grade band to grading scale (Admin only)",
        "tags": [
          "Configuration"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "scaleId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/config/exams": {
      "get": {
        "summary": "List all exams",
        "tags": [
          "Configuration"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "summary": "Create an exam",
        "tags": [
          "Configuration"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/config/exams/{examId}/classes": {
      "get": {
        "summary": "List classes for an exam",
        "tags": [
