      "get": {
        "summary": "List subjects and components for an exam_class",
        "tags": [
          "Configuration"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "examClassId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "summary": "Add subject to an exam class",
        "tags": [
          "Configuration"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "examClassId",
            "required": true
