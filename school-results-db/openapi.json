        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "examId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "summary": "Add class to an exam",
        "tags": [
          "Configuration"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
