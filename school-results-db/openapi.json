    "/api/marks/sheet": {
      "get": {
        "summary": "Get marks entry sheet for a class, subject, and section",
        "tags": [
          "Marks"
        ],
        "parameters": [
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "examClassId",
            "required": true
          },
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "classSubjectId",
            "required": true
          },
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "sectionId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/marks/bulk": {
      "put": {
        "summary": "Bulk save marks for components and enrollments",
        "tags": [
          "Marks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "marks"
                ],
                "properties": {
                  "marks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "componentId",
                        "enrollmentId",
                        "status"
                      ],
                      "properties": {
                        "componentId": {
                          "type": "number"
                        },
                        "enrollmentId": {
                          "type": "number"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "PRESENT",
                            "ABSENT",
                            "EXEMPT",
                            "MEDICAL_LEAVE",
                            "WITHHELD",
                            "NOT_APPLICABLE"
                          ]
                        },
                        "marksObtained": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "graceMarks": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "graceReason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "remarks": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/marks/missing": {
      "get": {
        "summary": "Get all missing marks entries for an exam class",
        "tags": [
          "Marks"
        ],
        "parameters": [
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "examClassId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
